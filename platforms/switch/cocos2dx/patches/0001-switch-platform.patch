+#ifdef __SWITCH__
+// Multi-touch from the Switch touchscreen (libnx HID). Touch coordinates are always in
+// 1280x720 panel space; scale them to the current frame size.
+static void switchPollTouches(GLViewImpl* view)
+{
+    static bool inited = false;
+    static std::unordered_map<intptr_t, Vec2> active;
+    if (!inited)
+    {
+        hidInitializeTouchScreen();
+        inited = true;
+    }
+
+    HidTouchScreenState state = {0};
+    if (hidGetTouchScreenStates(&state, 1) == 0)
+        return;
+
+    const Size frame = view->getFrameSize();
+    const float sx = frame.width / 1280.0f, sy = frame.height / 720.0f;
+
+    std::unordered_map<intptr_t, Vec2> now;
+    for (int i = 0; i < state.count && i < 16; ++i)
+    {
+        now[(intptr_t)state.touches[i].finger_id] =
+            Vec2(state.touches[i].x * sx, state.touches[i].y * sy);
+    }
+
+    intptr_t ids[16];
+    float xs[16], ys[16];
+    int nBegin = 0, nMove = 0, nEnd = 0;
+
+    for (auto& t : active)
+    {
+        if (now.find(t.first) == now.end())
+        {
+            ids[nEnd] = t.first; xs[nEnd] = t.second.x; ys[nEnd] = t.second.y; ++nEnd;
+        }
+    }
+    if (nEnd) view->handleTouchesEnd(nEnd, ids, xs, ys);
+
+    for (auto& t : now)
+    {
+        if (active.find(t.first) == active.end())
+        {
+            ids[nBegin] = t.first; xs[nBegin] = t.second.x; ys[nBegin] = t.second.y; ++nBegin;
+        }
+    }
+    if (nBegin) view->handleTouchesBegin(nBegin, ids, xs, ys);
+
+    for (auto& t : now)
+    {
+        auto it = active.find(t.first);
+        if (it != active.end() && it->second != t.second)
+        {
+            ids[nMove] = t.first; xs[nMove] = t.second.x; ys[nMove] = t.second.y; ++nMove;
+        }
+    }
+    if (nMove) view->handleTouchesMove(nMove, ids, xs, ys);
+
+    active.swap(now);
+}
+#endif
+
+#ifdef __SWITCH__
+void k2sPollControllers();                          // CCController-switch.cpp
+bool k2sIsEmulatedPadKey(int glfwKey, bool press);  // CCController-switch.cpp
+#endif
+
 void GLViewImpl::pollEvents()
 {
     glfwPollEvents();
+#ifdef __SWITCH__
+    switchPollTouches(this);
+    k2sPollControllers();
+#endif
 }
 
